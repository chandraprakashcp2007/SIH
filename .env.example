# ==============================================================================
# PRAHARI-NET Environment Configuration
# ==============================================================================
# Copy this file to .env for local runtime configuration.

# Database
# Default: SQLite with WAL mode for zero-dependency local operation on Windows.
# Production alternative: postgresql+asyncpg://prahari:prahari_secret@localhost:5432/prahari_net
DATABASE_URL=sqlite+aiosqlite:///./data/prahari.db

# Security & Authentication
SECRET_KEY=prahari-net-sih2026-super-secure-local-secret-key-change-in-prod-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
# Local development only. Set false outside a developer workstation.
DEV_AUTH_BYPASS=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Hardware Gateway / Serial LoRa
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
GATEWAY_MODE=SIMULATOR  # Options: REAL, SIMULATOR
GATEWAY_POLL_INTERVAL_SEC=2.0
GATEWAY_USERNAME=gateway
GATEWAY_PASSWORD=prahari-gateway-local

# Simulation Mode
SIMULATION_MODE=true
SIMULATION_TICK_RATE_MS=2000

# Computer Vision / Camera Integration (Optional)
VISION_ENABLED=false
VISION_STREAM_URL=
VISION_MODEL_PATH=

# Operational AI Copilot
# Options: DETERMINISTIC_LOCAL (Default, 100% offline), GEMINI, OPENAI
LLM_PROVIDER=DETERMINISTIC_LOCAL
LLM_API_KEY=
LLM_MODEL=

# Map Configuration
MAP_PROVIDER=OPENSTREETMAP  # Fallback to local grid/vector if internet unavailable

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Server Binding
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173
